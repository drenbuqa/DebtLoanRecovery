# ── Database ─────────────────────────────────────────────
# Strong random password for the local Postgres container
POSTGRES_PASSWORD=change_me_strong_password

# ── API security ─────────────────────────────────────────
# Random 64-character secret — generate with:
#   openssl rand -hex 32
JWT_SECRET=change_me_64_char_secret

# ── CORS ─────────────────────────────────────────────────
# The URL users open in their browser (your public domain)
# Multiple origins: comma-separated, no spaces
ALLOWED_ORIGINS=https://yourdomain.com

# ── Frontend ─────────────────────────────────────────────
# The public API URL — baked into the frontend at build time
# Must be reachable from the user's browser
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
